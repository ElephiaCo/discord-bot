{
	"name": "discord-bot",
	"version": "1.0.0",
	"description": "The discord bot for the Elephia discord!",
	"main": "index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsup",
		"start": "node dist/index.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check .",
		"check:fix": "biome check --write ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ElephiaCo/discord-bot.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "commonjs",
	"bugs": {
		"url": "https://github.com/ElephiaCo/discord-bot/issues"
	},
	"homepage": "https://github.com/ElephiaCo/discord-bot#readme",
	"dependencies": {
		"discord.js": "^14.26.5",
		"dotenv": "^17.4.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@types/node": "^26.1.1",
		"eslint": "^10.7.0",
		"prettier": "^3.9.5",
		"tsup": "^8.5.1",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
