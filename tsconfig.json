{
	"compilerOptions": {
		// File Layout
		//"rootDir": "src",
		//"outDir": "dist",

		// Environment Settings
		"module": "nodenext",
		"target": "ES2022",

		"types": ["node"],

		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true
	},
	"include": [
		"src/**/*.ts",
		"tests/**/*.ts",
		"vitest.config.ts",
		"tsup.config.ts"
	]
}
